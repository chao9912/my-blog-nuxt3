generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  desc        String?
  content     String
  cover       String?
  createTime  DateTime @default(now())
}

model Moment {
  id          Int      @id @default(autoincrement())
  content     String
  images      Json
  createTime  DateTime @default(now())
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
}